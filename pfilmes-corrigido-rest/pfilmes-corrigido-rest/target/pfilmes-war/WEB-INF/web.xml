<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>pFilmes</display-name>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <servlet>
        <servlet-name>AuthController</servlet-name>
        <servlet-class>controller.AuthController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthController</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>FilmeController</servlet-name>
        <servlet-class>controller.FilmeController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FilmeController</servlet-name>
        <url-pattern>/filmes</url-pattern>
    </servlet-mapping>
    <!-- API RESTful de filmes: usa o mesmo FilmeController das telas JSP. -->
    <servlet-mapping>
        <servlet-name>FilmeController</servlet-name>
        <url-pattern>/api/filmes/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AvaliacaoController</servlet-name>
        <servlet-class>controller.AvaliacaoController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AvaliacaoController</servlet-name>
        <url-pattern>/avaliacoes</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AvaliacaoController</servlet-name>
        <url-pattern>/avaliar</url-pattern>
    </servlet-mapping>
    <!-- API RESTful de avaliacoes: usa o mesmo AvaliacaoController das telas JSP. -->
    <servlet-mapping>
        <servlet-name>AvaliacaoController</servlet-name>
        <url-pattern>/api/avaliacoes/*</url-pattern>
    </servlet-mapping>
    <!-- Rota REST auxiliar para listar categorias em JSON. -->
    <servlet-mapping>
        <servlet-name>AvaliacaoController</servlet-name>
        <url-pattern>/api/categorias</url-pattern>
    </servlet-mapping>

    <filter>
        <filter-name>JwtFilter</filter-name>
        <filter-class>filter.JwtFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>JwtFilter</filter-name>
        <url-pattern>/filmes</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>JwtFilter</filter-name>
        <url-pattern>/avaliacoes</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>JwtFilter</filter-name>
        <url-pattern>/avaliar</url-pattern>
    </filter-mapping>
    <!-- As rotas REST tambem passam pelo filtro JWT. -->
    <filter-mapping>
        <filter-name>JwtFilter</filter-name>
        <url-pattern>/api/filmes/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>JwtFilter</filter-name>
        <url-pattern>/api/avaliacoes/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>JwtFilter</filter-name>
        <url-pattern>/api/categorias</url-pattern>
    </filter-mapping>

</web-app>
